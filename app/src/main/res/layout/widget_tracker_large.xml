<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tracker_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp" android:background="@drawable/widget_background" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tracker_widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tracker" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#555555" />
            <TextView android:id="@+id/tracker_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textSize="32sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#111111" android:layout_marginTop="2dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/tracker_widget_subtitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="22dp">
            <LinearLayout android:id="@+id/tracker_widget_value_progress_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <ProgressBar android:id="@+id/tracker_widget_value_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="0" android:progressTint="#69D38A" android:progressBackgroundTint="#44808080" />
                <TextView android:id="@+id/tracker_widget_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#555555" android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tracker_widget_value_progress_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tracker_widget_remaining" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tracker_widget_time_progress_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:visibility="gone">
                <ProgressBar android:id="@+id/tracker_widget_time_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progress="0" android:progressTint="#A78BFA" android:progressBackgroundTint="#33808080" />
                <TextView android:id="@+id/tracker_widget_time_progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#555555" android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tracker_widget_time_progress_percent" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tracker_widget_dates" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/tracker_widget_extra" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/tracker_widget_ring" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Tracker progress" />
</FrameLayout>
