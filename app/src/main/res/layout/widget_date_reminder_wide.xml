<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="52dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Choose a reminder"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" android:gravity="start"
            />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap this widget to select one"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" android:gravity="start"
            />

        <TextView
            android:id="@+id/widget_year_ends_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:visibility="gone"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" android:gravity="start"
            />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:text="Select reminder"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" android:gravity="start"
            />

        <TextView
            android:id="@+id/widget_total_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_secondary"
            android:textSize="9sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" android:gravity="start"
            />

        <TextView
            android:id="@+id/widget_small_days"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="@color/widget_secondary"
        android:textSize="10sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false" />

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="Countdown progress"
        android:src="@drawable/widget_ring"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="Refresh reminder countdown"
        android:src="@drawable/ic_refresh_widget" />
</FrameLayout>
