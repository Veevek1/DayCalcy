<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todo_item_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="32dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="3dp" android:paddingEnd="2dp" android:paddingTop="3dp" android:paddingBottom="3dp"
    android:background="@drawable/todo_task_background">
    <ImageView android:id="@+id/todo_item_check" android:layout_width="30dp" android:layout_height="25dp" android:paddingEnd="5dp" android:src="@drawable/ic_todo_circle" android:contentDescription="Task status" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/todo_item_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_text" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:id="@+id/todo_item_reminder_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:id="@+id/todo_item_reminder_icon" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_reminder" android:contentDescription="Reminder" />
            <TextView android:id="@+id/todo_item_reminder" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
