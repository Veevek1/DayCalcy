<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="12dp" android:background="@drawable/widget_background_light" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="36dp" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tax"
            android:textColor="#111111" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="01 Jan 2027" android:textColor="#5A5A5A" android:textSize="9sp" android:includeFontPadding="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="1 month 15 days" android:textColor="#111111" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:text="45 days" android:textColor="#5A5A5A" android:textSize="9sp" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="bottom|end"
        android:src="@drawable/widget_ring" android:scaleType="centerInside" android:contentDescription="Countdown progress" />
</FrameLayout>
