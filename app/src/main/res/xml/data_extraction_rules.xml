<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusion for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="date_reminder_widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="date_reminder_widgets.xml" />
    </device-transfer>
</data-extraction-rules>
